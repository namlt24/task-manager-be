# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).

# --- Database ---
DB_NAME=taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=change-me-strong-db-password

# --- JWT --- (must be strong, >= 32 bytes; generate with: openssl rand -base64 48)
JWT_SECRET=change-me-please-use-a-long-random-secret-key-at-least-32-bytes-long

# --- Public URL users open in the browser (IP or domain). ---
# Used for CORS and for invitation links sent by email. With a domain + HTTPS use https://...
PUBLIC_URL=http://your-server-ip

# --- Email (optional) ---
# Leave as-is to disable real email (app still works, just no invite/reminder emails).
# For Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 + App Password, AUTH/STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@taskmanager.local
